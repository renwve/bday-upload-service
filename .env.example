# Same Google OAuth app you already set up for the Next.js app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Optional: Drive folder ID to upload into (leave blank to use root of the Drive)
GOOGLE_DRIVE_FOLDER_ID=

# A random long string. Generate with: openssl rand -hex 32
# Must match what your Next.js app sends as the Bearer token.
UPLOAD_SERVICE_SECRET=
GOOGLE_DRIVE_UPLOAD_SERVICE_URL=

# Your deployed Next.js site's URL, e.g. https://your-birthday-site.vercel.app
# Use * only for quick testing, lock it down before the event.
ALLOWED_ORIGIN=https://happy-birthday-loraine-and-ren.vercel.app/

PORT=8080